{
    "manifest_version": 2,
    "name": "Transmission Torrent Control",
    "version": "1.0.0",
    "description": "Send torrent and magnet links to Transmission, with multi-label selection and presets.",
    "author": "Gianni Young",
    "homepage_url": "https://github.com/GianniBYoung/transmission-torrent-control",
    "default_locale": "en",
    "icons": {
        "32": "icon/default-32.png",
        "48": "icon/default-48.png",
        "64": "icon/default-64.png"
    },
    "options_ui": {
        "browser_style": true,
        "page": "view/options.html"
    },
    "browser_action": {
        "default_area": "navbar",
        "theme_icons": [
            {
                "light": "icon/default-light.svg",
                "dark": "icon/default.svg",
                "size": 32
            },
            {
                "light": "icon/default-light.svg",
                "dark": "icon/default.svg",
                "size": 64
            }
        ],
        "default_popup": "view/popup.html",
        "default_title": "Transmission Torrent Control"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "transmission-torrent-control@countmancy.com",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        },
        "gecko_android": {
            "strict_min_version": "142.0"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content-script.js"
            ],
            "all_frames": false
        }
    ],
    "permissions": [
        "contextMenus",
        "notifications",
        "storage",
        "webRequest",
        "webRequestBlocking",
        "<all_urls>"
    ],
    "background": {
        "page": "background.html"
    }
}
